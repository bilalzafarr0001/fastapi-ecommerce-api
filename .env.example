# Copy this file to `.env` and adjust the values.
# The real `.env` holds secrets: never commit it to git.

APP_NAME="ShopSphere API"

# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/shopsphere
# Set to true to print every SQL query in the console (great for learning)
DB_ECHO=false

# At least 32 characters. Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontends allowed to call the API from a browser (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=2
